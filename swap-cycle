#!/usr/bin/env python3
"""Cycle 1 GiB MADV_COLD workers until system swap usage reaches 50%."""

import mmap
import os
import select
import signal
import subprocess
import sys
import time

WORKER_SIZE = 1024**3
PAGE_SIZE = mmap.PAGESIZE
MADV_COLD_UAPI = 20
SWAP_THRESHOLD_PERCENT = 30
REPLACEMENT_DELAY_SECONDS = 1
SWAP_POLL_INTERVAL_SECONDS = 1
WORKER_READY_TIMEOUT_SECONDS = 10


def parse_swap_meminfo(contents):
    values = {}
    for line in contents.splitlines():
        fields = line.split()
        if len(fields) >= 3 and fields[0] in ("SwapTotal:", "SwapFree:"):
            try:
                values[fields[0][:-1]] = int(fields[1]) * (1024 if fields[2] == "kB" else 1)
            except ValueError:
                continue
    try:
        total, free = values["SwapTotal"], values["SwapFree"]
    except KeyError as exc:
        raise ValueError(f"missing {exc.args[0]} in /proc/meminfo") from exc
    if total <= 0 or free > total:
        raise ValueError("swap is not enabled or /proc/meminfo has invalid swap values")
    return total, total - free


def reached_threshold(total, used, threshold=SWAP_THRESHOLD_PERCENT):
    return used * 100 >= total * threshold


def swap_stats():
    with open("/proc/meminfo", encoding="ascii") as meminfo:
        return parse_swap_meminfo(meminfo.read())


def worker(ready_fd=None):
    if (not sys.platform.startswith("linux") or not hasattr(mmap.mmap, "madvise")
            or not hasattr(mmap, "MAP_ANONYMOUS")):
        raise RuntimeError("Linux anonymous mmap.madvise API is required for MADV_COLD")
    mapping = mmap.mmap(-1, WORKER_SIZE, flags=mmap.MAP_PRIVATE | mmap.MAP_ANONYMOUS,
                        prot=mmap.PROT_READ | mmap.PROT_WRITE)
    for offset in range(0, WORKER_SIZE, PAGE_SIZE):
        mapping[offset] = 1
    mapping.madvise(getattr(mmap, "MADV_COLD", MADV_COLD_UAPI))
    if ready_fd is not None:
        os.write(ready_fd, b"R")
        os.close(ready_fd)
    # Keep the anonymous mapping alive for the lifetime of this worker process.
    while True:
        signal.pause()


def stop_workers(workers):
    for process in workers:
        try:
            if process.poll() is None:
                process.terminate()
        except BaseException:
            # Still attempt wait/kill: a failed terminate must not orphan it.
            pass
        try:
            process.wait(timeout=2)
        except BaseException:
            try:
                process.kill()
            except BaseException:
                pass
            try:
                process.wait(timeout=2)
            except BaseException:
                # Best effort even if the caller is interrupted during cleanup.
                pass


def supervise():
    if not sys.platform.startswith("linux"):
        raise RuntimeError("swap-cycle requires Linux")
    total, used = swap_stats()
    workers = []
    script = os.path.abspath(__file__)

    def check_workers():
        for process in workers:
            code = process.poll()
            if code is not None:
                raise RuntimeError(f"worker exited unexpectedly with status {code}")

    def spawn():
        read_fd, write_fd = os.pipe()
        process = subprocess.Popen([sys.executable, script, "--worker", str(write_fd)],
                                   pass_fds=(write_fd,))
        os.close(write_fd)
        workers.append(process)
        try:
            readable, _, _ = select.select([read_fd], [], [], WORKER_READY_TIMEOUT_SECONDS)
            if not readable:
                raise RuntimeError("worker initialization timed out")
            ready = os.read(read_fd, 1)
        finally:
            os.close(read_fd)
        if ready != b"R":
            raise RuntimeError("worker failed before initialization")
        check_workers()

    try:
        if not workers:
            spawn()
        while not reached_threshold(total, used):
            remaining = REPLACEMENT_DELAY_SECONDS
            while remaining > 0:
                check_workers()
                interval = min(SWAP_POLL_INTERVAL_SECONDS, remaining)
                time.sleep(interval)
                remaining -= interval
                total, used = swap_stats()
                if reached_threshold(total, used):
                    break
            if not reached_threshold(total, used):
                spawn()
        while True:
            check_workers()
            oldest = workers.pop(0)
            try:
                oldest.terminate()
                oldest.wait(timeout=2)
            finally:
                stop_workers([oldest])
            time.sleep(REPLACEMENT_DELAY_SECONDS)
            spawn()
    finally:
        stop_workers(workers)


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if len(argv) in (1, 2) and argv[0] == "--worker":
        try:
            worker(int(argv[1]) if len(argv) == 2 else None)
        except (OSError, RuntimeError, ValueError) as exc:
            print(f"Worker allocation or MADV_COLD failed: {exc}", file=sys.stderr)
            return 1
    elif argv:
        print(f"Usage: {os.path.basename(__file__)}", file=sys.stderr)
        return 2
    try:
        supervise()
    except KeyboardInterrupt:
        return 0
    except (OSError, RuntimeError, ValueError) as exc:
        print(f"Cannot start swap-cycle: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
